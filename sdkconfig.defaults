# 全工程 -O2：软解 JPEG 性能关键（默认 -Og 下解码慢 2-3 倍）
CONFIG_COMPILER_OPTIMIZATION_PERF=y

# FreeRTOS tick 100Hz→1000Hz：vTaskDelay 精度 1ms，
# 帧节流（33.3ms）精确对齐，消除 10ms tick 取整导致的帧率损失
CONFIG_FREERTOS_HZ=1000

# FATFS 长文件名：SD 卡角色文件夹名（中文）、cards/card_<mac>.bin 等
# 都超 FAT 8.3；LFN 缓冲走堆（不占任务栈），路径 API 按 UTF-8 编解码
CONFIG_FATFS_LFN_HEAP=y
CONFIG_FATFS_MAX_LFN=255
CONFIG_FATFS_API_ENCODING_UTF_8=y

# CPU 240MHz（设计目标 @240MHz）。此配置同样只存在于生成过的
# sdkconfig 里，删除重配即丢——与下方 PSRAM 同坑，固化在此。
# 掉到 160MHz 的后果：软解 JPEG 帧率 25→18、字库解析/启动变慢。
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y

# ---- 硬件基础配置（N16R8：16MB Flash + 8MB Octal PSRAM）----
# 坑：这些配置原本只存在于手动配过的 sdkconfig.esp32-s3-devkitc-1 里，
# 删除该文件强制重配就会丢失——PSRAM 关闭后 LVGL 堆/视频缓冲/SD 字库
# 全部分配失败，表现为开机黑屏 + main 任务空转触发 task_wdt。勿删！
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_TYPE_AUTO=y
CONFIG_SPIRAM_CLK_IO=30
CONFIG_SPIRAM_CS_IO=26
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_BOOT_HW_INIT=y
CONFIG_SPIRAM_BOOT_INIT=y
CONFIG_SPIRAM_PRE_CONFIGURE_MEMORY_PROTECTION=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_MEMTEST=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=16384
CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL=32768
CONFIG_SPIRAM_ALLOW_STACK_EXTERNAL_MEMORY=y

# ---- 蓝牙（NimBLE GATT 外设：远程配置 + 素材上传）----
# 与 WiFi/ESP-NOW 软件共存；无配对直连；MTU 512 承载 ≤500B 上传块；
# 主机任务栈 8K（GATT 回调里做 SD 文件 IO）；SMP 关闭（免配对）。
# 坑：CONFIG_BT_NIMBLE 在 IDF5.2 命名，5.3+ 改为 CONFIG_BT_NIMBLE_ENABLED，
# 两个都写，不认识的会被自动忽略。
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_NIMBLE_ROLE_PERIPHERAL=y
CONFIG_BT_NIMBLE_MAX_CONNECTIONS=1
CONFIG_BT_NIMBLE_ATT_PREFERRED_MTU=512
CONFIG_BT_NIMBLE_ATT_MAX_VALUE_SIZE=600
CONFIG_BT_NIMBLE_HOST_TASK_STACK_SIZE=8192
CONFIG_BT_NIMBLE_SM_LEGACY=y
CONFIG_BT_NIMBLE_SM_SC=y
# GATT 属性表规模：3 服务 + 13 特性×2 + 1 CCCD = 30 属性，默认上限 15 不够
CONFIG_BT_NIMBLE_ATT_SVR_MAX_ATTRS=48
CONFIG_BT_NIMBLE_MSYS_2_BLOCK_COUNT=96
# RF 校准：combo 模式（BT 使能）下 PARTIAL 校准在预编译 libphy 内死循环
# （phy_init 日志后全系统静默）——NONE 模式直接复用 NVS 中已有的 wifi 校准数据
CONFIG_ESP_PHY_RF_CAL_NONE=y
CONFIG_ESP_PHY_CALIBRATION_MODE=0
# 软共存库在 wifi 启动阶段挂死（phy_init 前后 wifi_init 卡死，全系统僵）——
# 暂禁用，BLE 连接期间不与 ESP-NOW 并发收发（用户场景可接受，先跑通 BLE）
# CONFIG_ESP_COEX_SW_COEXIST_ENABLE=y

CONFIG_BT_NIMBLE_NVS_PERSIST=y

# 控制台走原生 USB-Serial-JTAG（PCB v6.2：无 USB-UART 桥，UART0 引脚留 H1 排针）；
# 关闭 UART 控制台与 USB 次级控制台输出，避免 UART0 被占用
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y
